rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if admin
    function isAdmin() {
      return request.auth != null;
    }

    // Services catalog: Anyone can view active services; admin can manage
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Service Zones: Anyone can read coverage; admin can manage
    match /serviceZones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Business Settings: Anyone can read operating hours & caps; admin can manage
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings: Guests can create bookings and look up their booking by ID; Admin has full access
    match /bookings/{bookingId} {
      allow create: if request.resource.data.referenceId != null 
                    && request.resource.data.guestPhone != null
                    && request.resource.data.guestName != null;
      allow read: if true;
      allow update: if isAdmin() || (
        // Guests can update for cancel or reschedule request
        request.resource.data.referenceId == resource.data.referenceId
      );
      allow delete: if isAdmin();
    }

    // Client Shadow Profiles CRM: Admin only
    match /clientShadowProfiles/{profileId} {
      allow read, write: if isAdmin();
    }

    // Health/connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
